if BOARD_BT60_CUSTOM

if USB

config USB_NRFX
	default y

config USB_DEVICE_STACK
	default y

endif # USB

config ZMK_BLE
	default y

config ZMK_USB
	default y

config ZMK_KEYBOARD_NAME
	default "BT60"

# The Adafruit nRF52 bootloader expects a specific magic value in
# retained memory to enter bootloader mode.
choice ZMK_BOOTMODE_MAGIC_VALUE_BOOTLOADER_TYPE
	default ZMK_BOOTMODE_MAGIC_VALUE_BOOTLOADER_TYPE_ADAFRUIT_NRF52

endchoice

endif # BOARD_BT60_CUSTOM
