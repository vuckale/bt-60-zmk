#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
				// -----------------------------------------------------------------------------------------------
				// | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  | PSCRN | BKSP  |
				// | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |              |
				// | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |  #   |   ENTER    |
				// | SHIFT |  NUBS  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  | /   | SHIFT |  NUHS  | 
				// |  CTL  |  WIN  |  ALT  |                     SPACE            |   ALT   |  1  | MENU | CTRL  |
				// -----------------------------------------------------------------------------------------------
			bindings = <
				&kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC &kp BSPC
				&kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp UP &kp RBKT
				&kp LCTRL &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp LEFT &kp DOWN &kp RIGHT &kp RET
				&kp LSHFT &kp NON_US_BSLH &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp NON_US_HASH
				&trans &kp LALT &kp LGUI                    &kp SPACE                    &trans &kp RALT &mo 1 &trans &bt BT_CLR
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
		};
		raise {
			bindings = <
				&kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &tog 2 &kp DEL
				&trans &kp INS &kp HOME &kp PG_UP &trans &trans &trans &trans &trans &trans &kp PSCRN &kp LBKT &trans
				&kp CLCK &kp DEL &kp END &kp PG_DN &trans &trans &trans &trans &trans &trans &kp SEMI &kp SQT &kp NON_US_HASH &trans
				&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp K_CMENU
				&trans &kp K_CMENU &kp RGUI                &trans                      &trans &kp RCTRL &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
		};
		// numpad_bt (layer 2): toggle with Fn + the key between = and Backspace
		// Left hand = Bluetooth / output, right hand = numpad
		//   1 2 3 4 5     -> BT_SEL 0..4  (select / pair profile 1..5)
		//   Q W E R T     -> BT_DISC 0..4 (disconnect that profile, keeps pairing)
		//   A S           -> BT_PRV / BT_NXT (cycle profiles)
		//   D F           -> OUT_USB / OUT_BLE (choose output)
		//   Z             -> BT_CLR (unpair current profile)
		//   C             -> BT_CLR_ALL (wipe ALL profiles; X is left empty on purpose)
		//   7 8 9 / U I O / J K L / M -> numpad 7 8 9 / 4 5 6 / 1 2 3 / 0
		numpad_bt {
			bindings = <
				&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &trans &trans &trans &trans &trans
				&trans &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4 &trans &kp KP_N4 &kp KP_N5 &kp KP_N6 &trans &trans &trans
				&trans &bt BT_PRV &bt BT_NXT &out OUT_USB &out OUT_BLE &trans &trans &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans &trans &trans &trans
				&trans &trans &bt BT_CLR &trans &bt BT_CLR_ALL &trans &trans &kp KP_NLCK &kp KP_N0 &trans &trans &trans &trans &trans
				&trans &trans &trans                    &trans                      &trans &trans &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
		};
	};
};

// &kp SQT -> Ä ä
// &kp LBKT -> Ü ü
// &kp SEMI -> Ö ö
// &sys_reset, &bootloader -> https://zmk.dev/docs/behaviors/reset
// layers -> https://zmk.dev/docs/behaviors/layers
// keycodes -> https://zmk.dev/docs/codes
// &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_CLR &bt BT_PRV &bt BT_NXT
