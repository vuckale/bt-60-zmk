# BT60 (custom layout) board configuration

# Copyright (c) 2021 Polarity Works
# SPDX-License-Identifier: MIT

config BOARD_BT60_CUSTOM
	select SOC_NRF52840_QIAA
	# Boot mode retention, needed for the &bootloader behavior with the
	# Adafruit nRF52 bootloader (see bt60_custom.dts and Kconfig.defconfig).
	imply RETAINED_MEM
	imply RETENTION
	imply RETENTION_BOOT_MODE
